hub.subfuncs.IsChromaId = function(itemId, name, info)
	local s = (tostring(itemId or "") .. " " .. tostring(name or "")):lower()
	if s:find("chroma", 1, true) then
		return true
	end
	if info then
		local n = tostring(info.ItemName or info.Name or info.DisplayName or ""):lower()
		if n:find("chroma", 1, true) then
			return true
		end
		local r = tostring(info.Rarity or info.ItemRarity or ""):lower()
		if r:find("chroma", 1, true) then
			return true
		end
	end
	return false
end

hub.subfuncs.StripChromaPrefix = function(s)
	s = tostring(s or "")
	s = s:gsub("^[Cc]hroma%s+", "")
	s = s:gsub("^c%.%s*", "")
	return s
end

hub.subfuncs.LookupValue = function(name, itemId, itemType, info)
	local idBase, idKind, idYear, idChroma = hub.subfuncs.ParseItemId(itemId)
	local kind = hub.subfuncs.WeaponKind(itemType, itemId, info, idKind)
	local rarity = info and (info.Rarity or info.ItemRarity) or nil
	local displayName = name or idBase
	local wantChroma = idChroma or hub.subfuncs.IsChromaId(itemId, displayName, info)
	local baseName = hub.subfuncs.StripChromaPrefix(displayName)
	local baseId = hub.subfuncs.StripChromaPrefix(idBase or "")

	local queries = {}
	local function addQ(s)
		if s and s ~= "" then queries[#queries + 1] = s end
	end

	if wantChroma then
		addQ("Chroma " .. baseName)
		addQ("Chroma " .. baseId)
		addQ("C. " .. baseName)
		if kind == "gun" then
			addQ("Chroma " .. baseName .. " (Gun)")
			addQ("Chroma " .. baseId .. " (Gun)")
		elseif kind == "knife" then
			addQ("Chroma " .. baseName .. " (Knife)")
			addQ("Chroma " .. baseId .. " (Knife)")
		end
		addQ(displayName)
		addQ(idBase)
	else
		addQ(displayName)
		addQ(idBase)
		addQ(baseName)
		addQ(baseId)
		if kind == "gun" then
			addQ(displayName .. " (Gun)")
			addQ((idBase or displayName) .. " (Gun)")
			addQ(baseName .. " (Gun)")
			if idYear then
				addQ(string.format("%s (Gun) [XMAS%s]", displayName, idYear))
				addQ(string.format("%s (Gun) [HALLOWS%s]", displayName, idYear))
			end
		elseif kind == "knife" then
			addQ(displayName .. " (Knife)")
			addQ((idBase or displayName) .. " (Knife)")
			addQ(baseName .. " (Knife)")
			if idYear then
				addQ(string.format("%s (Knife) [XMAS%s]", displayName, idYear))
				addQ(string.format("%s (Knife) [HALLOWS%s]", displayName, idYear))
			end
		end
	end
	if info then
		addQ(info.ItemName)
		addQ(info.Name)
	end

	local best, bestScore = nil, -math.huge
	local seen = {}

	for _, q in ipairs(queries) do
		local n = hub.subfuncs.Norm(q)
		local bucket = ByNorm[n]
		if bucket then
			for _, entry in ipairs(bucket) do
				if not seen[entry] then
					seen[entry] = true
					local sc = hub.subfuncs.ScoreEntry(entry, kind, idYear, rarity, n, wantChroma)
					if sc > bestScore then
						bestScore = sc
						best = entry
					end
				end
			end
		end
	end

	if not best or bestScore < 40 then
		local baseN = hub.subfuncs.Norm(wantChroma and ("chroma " .. baseName) or baseName)
		if baseN ~= "" then
			for _, entry in ipairs(Entries) do
				if not seen[entry] then
					local en = entry.norm
					local enBase = en
						:gsub("%s*chroma%s*", " ")
						:gsub("%s*%(gun%)", "")
						:gsub("%s*%(knife%)", "")
						:gsub("%s*%[.-%]", "")
						:gsub("%s+", " ")
						:match("^%s*(.-)%s*$") or en
					local cmp = hub.subfuncs.Norm(baseName)
					if enBase == cmp or en == baseN or (wantChroma and en:find("chroma", 1, true) and enBase == cmp) then
						local sc = hub.subfuncs.ScoreEntry(entry, kind, idYear, rarity, baseN, wantChroma)
						if sc > bestScore then
							bestScore = sc
							best = entry
						end
					end
				end
			end
		end
	end

	if best and bestScore >= 40 then
		if typeof(best.value) == "number" and best.value >= 1 then
			return best.value, best.key, bestScore
		end
		return nil, best.key, bestScore
	end
	return nil, nil, nil
end

hub.subfuncs.GetItemInfo = function(itemType, itemId)
	local bucket = Sync[itemType]
	if typeof(bucket) ~= "table" then
		return nil
	end
	local info = bucket[itemId] or bucket[tostring(itemId)] or bucket[tonumber(itemId)]
	return typeof(info) == "table" and info or nil
end

hub.subfuncs.ParseEntry = function(entry)
	return entry[1] or entry.ItemID or entry.ItemId,
		entry[2] or entry.Amount or 1,
		entry[3] or entry.ItemType or entry.Type or "Weapons"
end

hub.subfuncs.Describe = function(entry)
	local itemId, amount, itemType = hub.subfuncs.ParseEntry(entry)
	local info = hub.subfuncs.GetItemInfo(itemType, itemId)
	local name = tostring(itemId)
	local rarity = "?"
	if info then
		name = info.ItemName or info.Name or info.DisplayName or name
		rarity = info.Rarity or info.ItemRarity or rarity
	end
	local idBase, idKind, idYear = hub.subfuncs.ParseItemId(itemId)
	local allowed = hub.subfuncs.IsAllowedRarity(rarity)
	local value, matchedKey, score = nil, nil, nil
	if allowed then
		value, matchedKey, score = hub.subfuncs.LookupValue(name, itemId, itemType, info)
	end
	local amountN = tonumber(amount) or 1
	local okVal = value and value >= 1
	return {
		id = itemId,
		name = name,
		rarity = tostring(rarity),
		allowed = allowed,
		amount = amountN,
		type = tostring(itemType),
		year = idYear,
		kind = idKind or hub.subfuncs.WeaponKind(itemType, itemId, info, idKind),
		value = okVal and value or nil,
		matchedKey = matchedKey,
		matchScore = score,
		stackValue = okVal and (value * amountN) or nil,
	}
end

hub.subfuncs.SumOffer = function(offer)
	local total, known, unknown, ignored = 0, 0, 0, 0
	for _, entry in ipairs(offer or {}) do
		local d = hub.subfuncs.Describe(entry)
		if not d.allowed then
			ignored += 1
		elseif d.value and d.value >= 1 then
			total += d.stackValue
			known += 1
		else
			unknown += 1
		end
	end
	return total, known, unknown, ignored
end

hub.subfuncs.Fingerprint = function(offer)
	local parts = {}
	for i, entry in ipairs(offer or {}) do
		local d = hub.subfuncs.Describe(entry)
		parts[i] = string.format("%s:%s:x%d", d.type, tostring(d.id), d.amount)
	end
	table.sort(parts)
	return table.concat(parts, "|")
end

