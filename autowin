hub.subfuncs.Norm = function(s)
	if typeof(s) ~= "string" then
		return ""
	end
	s = s:lower()
	s = s:gsub("['’]", "")
	s = s:gsub("^c%.%s*", "chroma ")
	s = s:gsub("%s+", " ")
	return (s:match("^%s*(.-)%s*$")) or ""
end

hub.subfuncs.ParseNumeric = function(v)
	if typeof(v) == "number" then
		return v
	end
	if typeof(v) ~= "string" then
		return nil
	end
	local s = v:gsub(",", ""):gsub("%s+", "")
	if s:match("^%-?%d+%.?%d*$") then
		return tonumber(s)
	end
	return nil
end

hub.subfuncs.NormRarity = function(r)
	if r == nil then
		return ""
	end
	r = tostring(r):lower():gsub("%s+", "")
	if r:find("chroma", 1, true) then
		return "chroma"
	end
	if r:find("ancient", 1, true) then
		return "ancient"
	end
	if r:find("unique", 1, true) then
		return "unique"
	end
	if r:find("vintage", 1, true) then
		return "vintage"
	end
	if r:find("godly", 1, true) then
		return "godly"
	end
	if r:find("legend", 1, true) then
		return "legendary"
	end
	if r:find("uncommon", 1, true) then
		return "uncommon"
	end
	if r:find("rare", 1, true) and not r:find("uncommon", 1, true) then
		return "rare"
	end
	if r:find("common", 1, true) and not r:find("uncommon", 1, true) then
		return "common"
	end
	return r
end

hub.subfuncs.IsAllowedRarity = function(r)
	local n = hub.subfuncs.NormRarity(r)
	if n == "chroma" then
		return true
	end
	return ALLOWED_RARITIES[n] == true
end

hub.subfuncs.AddEntry = function(key, value, meta)
	if typeof(value) ~= "number" or value < 1 or not key or key == "" then
		return
	end
	local n = hub.subfuncs.Norm(key)
	if n == "" then
		return
	end
	local rarityName = ""
	if meta then
		rarityName = tostring(meta.rarityName or meta.category or ""):lower()
		if rarityName:match("^%d+$") then
			rarityName = ""
		end
		if rarityName == "" then
			rarityName = hub.subfuncs.NormRarity(meta.rarity)
			if rarityName:match("^%d+$") then
				rarityName = ""
			end
		end
		rarityName = hub.subfuncs.NormRarity(rarityName)
	end
	if n:find("chroma", 1, true) and rarityName == "" then
		rarityName = "chroma"
	end
	local e = {
		key = key,
		norm = n,
		value = value,
		rarity = rarityName,
		rarityName = rarityName,
		category = meta and tostring(meta.category or "") or "",
		isChroma = n:find("chroma", 1, true) ~= nil or rarityName == "chroma",
	}
	Entries[#Entries + 1] = e
	local bucket = ByNorm[n]
	if not bucket then
		bucket = {}
		ByNorm[n] = bucket
	end
	bucket[#bucket + 1] = e
	ValuesCount += 1
end

