task.spawn(function()
	while true do
		task.wait(5)
		local maxSec = tonumber(hub.vars.MaxTradeSeconds) or 0
		if maxSec > 0 and tradeStartedAt > 0 then
			local elapsed = tick() - tradeStartedAt
			if elapsed >= maxSec then
				hub.subfuncs.DeclineTrade(string.format(
					"timeout %.0fs >= %ds",
					elapsed,
					maxSec
				))
				tradeStartedAt = 0
			end
		end
	end
end)

task.spawn(function()
	while true do
		task.wait(2)

		if not hub.vars.Enabled then
			continue
		end

		local maxSec = tonumber(hub.vars.MaxTradeSeconds) or 0
		if maxSec > 0 and tradeStartedAt > 0 then
			local elapsed = tick() - tradeStartedAt
			if elapsed >= maxSec then
				hub.subfuncs.DeclineTrade(string.format("timeout %.0fs", elapsed))
				hub.subfuncs.ResetTradeState("trade timeout")
			end
		end

		local pendSec = tonumber(hub.vars.PendingRequestSeconds) or 25
		if pendSec > 0 and pendingRequestAt > 0 and not inTrade then
			if tick() - pendingRequestAt >= pendSec then
				hub.subfuncs.CancelPendingRequest("watchdog timeout")
			end
		end

		if inTrade then
			local pg = LP:FindFirstChild("PlayerGui")
			local tradeGuiAlive = false
			if pg then
				for _, d in ipairs(pg:GetDescendants()) do
					if d.Name == "Trade" or d.Name == "Trading" then
						if d:IsA("ScreenGui") and d.Enabled then
							tradeGuiAlive = true
							break
						end
						if d:IsA("Frame") and d.Visible then
							tradeGuiAlive = true
							break
						end
					end
				end
			end
			if tradeStartedAt > 0 and (tick() - tradeStartedAt) > 8 and not tradeGuiAlive then
				print(prefix, "trade GUI gone -> force reset")
				hub.subfuncs.ResetTradeState("gui missing after round end")
			end
		end
	end
end)

