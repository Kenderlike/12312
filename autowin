hub.subfuncs.ClearOurOffer = function(ourOffer)
	if not ourOffer or #ourOffer == 0 then
		return
	end
	hub.subfuncs.Log("clearing our offer (" .. #ourOffer .. " stacks)")
	pcall(function()
		Trade.CancelAccept:FireServer()
	end)
	for _, entry in ipairs(ourOffer) do
		local itemId, amount, itemType = hub.subfuncs.ParseEntry(entry)
		local amt = tonumber(amount) or 1
		for _ = 1, amt do
			hub.subfuncs.RemoveOfferItem(itemId, itemType)
			task.wait(0.06)
		end
	end
	alreadyOffered = {}
end

hub.subfuncs.SelectCounterOffer = function(theirTotal, inventory, currentOurTotal)
	local budget = theirTotal / hub.vars.MinProfit - (currentOurTotal or 0)
	if budget <= 0 then
		return {}, 0
	end

	local sorted = table.clone(inventory)
	table.sort(sorted, function(a, b)
		if a.value == b.value then
			return a.amount > b.amount
		end
		return a.value > b.value
	end)

	local selected = {}
	local used = 0
	local stacks = 0
	local taken = {}

	local function available(item)
		return item.amount - (alreadyOffered[item.id] or 0) - (taken[item.id] or 0)
	end

	for _, item in ipairs(sorted) do
		if stacks >= hub.vars.MaxStacks then
			break
		end
		local avail = available(item)
		if avail > 0 and item.value >= 1 and item.value <= budget + 1e-9 then
			local maxN = math.floor((budget + 1e-9) / item.value)
			local take = math.min(avail, maxN)
			if take > 0 then
				selected[#selected + 1] = {
					id = item.id,
					name = item.name,
					amount = take,
					value = item.value,
					type = item.type,
				}
				used += item.value * take
				budget -= item.value * take
				stacks += 1
				taken[item.id] = (taken[item.id] or 0) + take
			end
		end
	end

	if budget >= 1 and stacks < hub.vars.MaxStacks then
		table.sort(sorted, function(a, b)
			return a.value < b.value
		end)
		for _, item in ipairs(sorted) do
			if stacks >= hub.vars.MaxStacks then
				break
			end
			local avail = available(item)
			if avail > 0 and item.value >= 1 and item.value <= budget + 1e-9 then
				local maxN = math.floor((budget + 1e-9) / item.value)
				local take = math.min(avail, maxN)
				if take > 0 then
					selected[#selected + 1] = {
						id = item.id,
						name = item.name,
						amount = take,
						value = item.value,
						type = item.type,
					}
					used += item.value * take
					budget -= item.value * take
					stacks += 1
					taken[item.id] = (taken[item.id] or 0) + take
				end
			end
		end
	end

	return selected, used
end

hub.subfuncs.IsOfferProfitable = function(theirTotal, ourTotal)
	if theirTotal <= 0 or ourTotal <= 0 then
		return false
	end
	return theirTotal >= ourTotal * hub.vars.MinProfit
end

hub.subfuncs.IsOfferOverBudget = function(theirTotal, ourTotal)
	if theirTotal <= 0 then
		return ourTotal > 0
	end
	return ourTotal > (theirTotal / hub.vars.MinProfit) + 0.01
end

hub.subfuncs.PrintSide = function(label, offer, prevFp)
	local fp = hub.subfuncs.Fingerprint(offer)
	if fp == prevFp then
		return fp, false
	end
	local total, known, unknown, ignored = hub.subfuncs.SumOffer(offer)
	print(string.format(
		"========== %s (%d stacks | value %s | known %d | ignored %d | unknown %d) ==========",
		label,
		#(offer or {}),
		known > 0 and tostring(total) or "?",
		known,
		ignored,
		unknown
	))
	if not offer or #offer == 0 then
		print("  (empty)")
		return fp, true
	end
	for i, entry in ipairs(offer) do
		local d = hub.subfuncs.Describe(entry)
		local valStr
		if not d.allowed then
			valStr = "IGNORED (" .. d.rarity .. ")"
		elseif d.value and d.value >= 1 then
			valStr = string.format("%s (x%d = %s) via %s", d.value, d.amount, d.stackValue, tostring(d.matchedKey))
		else
			valStr = string.format("N/A (no match for %s/%s/%s/%s)", d.name, tostring(d.kind), tostring(d.year), d.rarity)
		end
		print(string.format(
			"  [%d] %s | %s | x%d | %s | ID:%s | Y:%s | Value: %s",
			i,
			d.name,
			d.rarity,
			d.amount,
			d.type,
			tostring(d.id),
			tostring(d.year),
			valStr
		))
	end
	return fp, true
end

