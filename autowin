hub.subfuncs.GetOwnedWeapons = function()
	local ok, data = pcall(function()
		return InventoryRemote.GetProfileData:InvokeServer(LP.Name)
	end)
	if not ok or typeof(data) ~= "table" then
		warn(prefix.." GetProfileData failed:", data)
		return {}
	end
	local owned = data.Weapons and data.Weapons.Owned
	if typeof(owned) ~= "table" then
		return {}
	end
	local list = {}
	for dataId, amount in pairs(owned) do
		local amt = tonumber(amount) or 0
		if amt > 0 then
			local info = hub.subfuncs.GetItemInfo("Weapons", dataId)
			local name = info and (info.ItemName or info.Name) or tostring(dataId)
			local rarity = info and (info.Rarity or info.ItemRarity) or "?"
			if hub.subfuncs.IsAllowedRarity(rarity) then
				local value = hub.subfuncs.LookupValue(name, dataId, "Weapons", info)
				if value and value >= 1 then
					list[#list + 1] = {
						id = dataId,
						name = name,
						rarity = tostring(rarity),
						amount = amt,
						value = value,
						type = "Weapons",
					}
				end
			end
		end
	end
	table.sort(list, function(a, b)
		if a.value == b.value then
			return a.amount > b.amount
		end
		return a.value < b.value
	end)
	return list
end

