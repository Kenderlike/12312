hub.subfuncs.ParseItemId = function(itemId)
	local id = tostring(itemId or "")
	local chroma = false
	local work = id
	if work:lower():find("chroma", 1, true) then
		chroma = true
		work = work:gsub("[Cc]hroma", "")
	end
	local base, kindLetter, year = work:match("^(.+)_([GKgk])_(%d%d%d%d)$")
	if base then
		base = base:gsub("_+$", ""):gsub("^_+", "")
		return base, (kindLetter:upper() == "G") and "gun" or "knife", year, chroma
	end
	base, kindLetter = work:match("^(.+)_([GKgk])$")
	if base then
		base = base:gsub("_+$", ""):gsub("^_+", "")
		return base, (kindLetter:upper() == "G") and "gun" or "knife", nil, chroma
	end
	year = id:match("(20%d%d)")
	base = work:match("^([%w%s']+)") or work
	base = base:gsub("_+$", ""):gsub("^_+", "")
	return base, nil, year, chroma
end

hub.subfuncs.WeaponKind = function(itemType, itemId, info, parsedKind)
	if parsedKind then
		return parsedKind
	end
	local t = tostring(itemType or ""):lower()
	if t:find("gun", 1, true) then
		return "gun"
	end
	if t:find("knife", 1, true) then
		return "knife"
	end
	if info then
		local n = tostring(info.ItemName or info.Name or ""):lower()
		if n:find("%(gun%)") then
			return "gun"
		end
		if n:find("%(knife%)") then
			return "knife"
		end
	end
	return nil
end

hub.subfuncs.ScoreEntry = function(entry, wantKind, wantYear, wantRarity, queryNorm, wantChroma)
	local score = 0
	local key = entry.norm
	local entryChroma = entry.isChroma == true
		or key:find("chroma", 1, true) ~= nil
		or hub.subfuncs.NormRarity(entry.rarityName or entry.rarity or entry.category) == "chroma"

	if wantChroma and not entryChroma then
		return -100
	end
	if not wantChroma and entryChroma then
		return -100
	end
	if wantChroma and entryChroma then
		score += 60
	end

	local keyBase = key
		:gsub("%s*chroma%s*", " ")
		:gsub("%s*%(gun%)", "")
		:gsub("%s*%(knife%)", "")
		:gsub("%s*%[.-%]", "")
		:gsub("%s+", " ")
		:match("^%s*(.-)%s*$") or key

	local queryBase = queryNorm
		:gsub("%s*chroma%s*", " ")
		:gsub("%s*%(gun%)", "")
		:gsub("%s*%(knife%)", "")
		:gsub("%s*%[.-%]", "")
		:gsub("%s+", " ")
		:match("^%s*(.-)%s*$") or queryNorm

	if keyBase ~= queryBase then
		if #keyBase > #queryBase then
			local rest = keyBase:sub(#queryBase + 1):match("^%s*(.+)$") or ""
			rest = rest:lower()
			if rest ~= ""
				and not rest:match("^%(gun%)$")
				and not rest:match("^%(knife%)$")
				and not rest:match("^%[%w+%]$")
				and not rest:match("^20%d%d$")
			then
				return -100
			end
		else
			return -100
		end
	end

	local hasGun = key:find("%(gun%)", 1, false) ~= nil
	local hasKnife = key:find("%(knife%)", 1, false) ~= nil

	if wantKind == "gun" then
		if hasGun then score += 50
		elseif hasKnife then return -1 end
	elseif wantKind == "knife" then
		if hasKnife then score += 50
		elseif hasGun then return -1 end
	end

	local yearInKey = key:match("(20%d%d)")
	if wantYear then
		if yearInKey == wantYear then score += 40
		elseif yearInKey and yearInKey ~= wantYear then score -= 30 end
	end

	local er = hub.subfuncs.NormRarity(entry.rarityName or entry.rarity or entry.category)
	local wr = hub.subfuncs.NormRarity(wantRarity)
	if wantChroma then wr = "chroma" end
	if wr ~= "" and er ~= "" and wr ~= er then
		if not (wantChroma and er == "chroma") then
			return -100
		end
	end
	if wr ~= "" and er == wr then score += 40 end
	if key == queryNorm then score += 30 end
	if keyBase == queryBase then score += 25 end
	if hasGun or hasKnife then score += 5 end
	if key:find("%[", 1, true) then score += 5 end
	return score
end

