hub.funcs.LoadValues = function()
	local req = hub.subfuncs.GetRequest()
	if typeof(req) ~= "function" then
		warn(prefix.." no request function")
		return false
	end
	local ok, res = pcall(function()
		return req({
			Url = VALUES_URL,
			Method = "GET",
			Headers = { ["Accept"] = "application/json" },
		})
	end)
	if not ok or typeof(res) ~= "table" then
		warn(prefix.." request failed:", res)
		return false
	end
	local status = res.StatusCode or res.Status or 0
	local body = res.Body or res.body or ""
	if status < 200 or status >= 300 or body == "" then
		warn(prefix.." bad status", status, #body)
		return false
	end
	local decodeOk, data = pcall(function()
		return HttpService:JSONDecode(body)
	end)
	if not decodeOk or typeof(data) ~= "table" then
		warn(prefix.." JSON decode failed")
		return false
	end

	Entries = {}
	ByNorm = {}
	ValuesCount = 0

	local meta = typeof(data.meta) == "table" and data.meta or {}

	if typeof(data.byRarity) == "table" then
		for rarityName, bucket in pairs(data.byRarity) do
			if typeof(bucket) == "table" then
				local rn = hub.subfuncs.NormRarity(rarityName)
				for name, val in pairs(bucket) do
					if typeof(val) == "number" and val >= 1 then
						hub.subfuncs.AddEntry(tostring(name), val, {
							rarityName = rn,
							category = rn,
						})
					end
				end
			end
		end
	end

	if typeof(data.values) == "table" then
		for name, val in pairs(data.values) do
			if typeof(val) == "number" and val >= 1 then
				hub.subfuncs.AddEntry(tostring(name), val, meta[name])
			end
		end
	end

	for name, info in pairs(meta) do
		if typeof(info) == "table" then
			local num = hub.subfuncs.ParseNumeric(info.value)
				or hub.subfuncs.ParseNumeric(info.valueText)
				or hub.subfuncs.ParseNumeric(info.rawValue)
			if num and num >= 1 then
				hub.subfuncs.AddEntry(tostring(name), num, info)
				if typeof(info.name) == "string" and info.name ~= name then
					hub.subfuncs.AddEntry(info.name, num, info)
				end
			end
		end
	end

	if typeof(data.aliases) == "table" then
		for alias, target in pairs(data.aliases) do
			local tBucket = ByNorm[hub.subfuncs.Norm(tostring(target))]
			if tBucket and tBucket[1] and tBucket[1].value >= 1 then
				hub.subfuncs.AddEntry(tostring(alias), tBucket[1].value, {
					rarityName = tBucket[1].rarityName,
					category = tBucket[1].category,
				})
			end
		end
	end

	for name, info in pairs(meta) do
		if typeof(info) == "table" and typeof(info.aliases) == "string" then
			local a = info.aliases
			if a ~= "" and a ~= "N/A" then
				local tBucket = ByNorm[hub.subfuncs.Norm(name)]
				local val = tBucket and tBucket[1] and tBucket[1].value
				if not val then
					val = hub.subfuncs.ParseNumeric(info.value) or hub.subfuncs.ParseNumeric(info.valueText)
				end
				if val and val >= 1 then
					for part in a:gmatch("[^,]+") do
						hub.subfuncs.AddEntry(part, val, info)
					end
				end
			end
		end
	end

	print(string.format(prefix.." values loaded: %d | updatedAt: %s", ValuesCount, tostring(data.updatedAt)))
	return ValuesCount > 0
end

hub.subfuncs.CancelPendingRequest = function(reason)
	print(prefix, "CancelPendingRequest:", reason or "", tostring(pendingRequestName))
	pcall(function()
		Trade.DeclineTrade:FireServer()
	end)
	pcall(function()
		local r = Trade:FindFirstChild("CancelRequest") or Trade:FindFirstChild("DeclineRequest")
		if r then
			if r:IsA("RemoteEvent") then
				r:FireServer()
			elseif r:IsA("RemoteFunction") then
				r:InvokeServer()
			end
		end
	end)
	pendingRequestAt = 0
	pendingRequestName = nil
end

hub.funcs.SendTradeRound = function()
	if not hub.vars.Enabled then return end
	if not hub.vars.AutoSendTrades then return end
	if inTrade then return end
	if busy or acceptScheduled then return end

	if pendingRequestAt > 0 then
		local pendSec = tonumber(hub.vars.PendingRequestSeconds) or 25
		if tick() - pendingRequestAt < pendSec then
			return
		end
		hub.subfuncs.CancelPendingRequest("expired before next send")
		task.wait(0.35)
	end

	for _, plr in ipairs(Players:GetPlayers()) do
		if not hub.vars.Enabled or not hub.vars.AutoSendTrades then break end
		if inTrade or busy or acceptScheduled then break end
		if plr ~= LP and plr.Character then
			local ok, err = pcall(function()
				Trade.SendRequest:InvokeServer(plr)
			end)
			print(prefix, "SendRequest ->", plr.Name, ok and "OK" or tostring(err))
			if ok then
				pendingRequestAt = tick()
				pendingRequestName = plr.Name
				return
			end
			task.wait(hub.vars.SendInterval)
		end
	end
end

hub.funcs.OnTradeRequest = function(fromPlayer)
	if not hub.vars.Enabled then return end
	if not hub.vars.AutoAcceptRequest then return end
	if inTrade or tradeStartedAt > 0 then return end
	local name = (typeof(fromPlayer) == "Instance" and fromPlayer.Name) or tostring(fromPlayer)
	hub.subfuncs.Log("incoming trade request from", name)
	task.wait(0.15)
	local ok, err = pcall(function()
		Trade.AcceptRequest:FireServer()
	end)
	if ok then
		hub.subfuncs.Log("AcceptRequest sent ->", name)
	else
		warn(prefix.." AcceptRequest failed:", err)
	end
end

hub.funcs.RebuildOffer = function(theirTotal)
	local inv = hub.subfuncs.GetOwnedWeapons()
	if #inv == 0 then
		warn(prefix.." inventory empty or no Godly/Unique/Ancient")
		return
	end
	alreadyOffered = {}
	local selected, addValue = hub.subfuncs.SelectCounterOffer(theirTotal, inv, 0)
	local budget = theirTotal / hub.vars.MinProfit
	if #selected == 0 then
		hub.subfuncs.Log(string.format("no items fit budget %.2f (their %.2f)", budget, theirTotal))
		return
	end
	hub.subfuncs.Log(string.format(
		"placing offer | their=%.2f budget<=%.2f us~=%.2f stacks=%d",
		theirTotal,
		budget,
		addValue,
		#selected
	))
	for _, item in ipairs(selected) do
		hub.subfuncs.Log(string.format("  + %s x%d (%.2f) [%s]", item.name, item.amount, item.value * item.amount, item.rarity or "?"))
		for _ = 1, item.amount do
			hub.subfuncs.OfferItem(item.id, item.type)
			task.wait(0.07)
		end
		alreadyOffered[item.id] = (alreadyOffered[item.id] or 0) + item.amount
	end
	local pct = addValue > 0 and ((theirTotal - addValue) / addValue * 100) or 0
	hub.subfuncs.Log(string.format(
		"done | us=%.2f them=%.2f diff=%+.2f (%.1f%%)",
		addValue,
		theirTotal,
		theirTotal - addValue,
		pct
	))
end

hub.funcs.ScheduleAccept = function()
	if not hub.vars.Enabled then return end
	if not hub.vars.AutoAccept then
		return
	end
	if acceptScheduled then
		return
	end
	acceptScheduled = true
	task.spawn(function()
		while acceptScheduled do
			local left = hub.subfuncs.SecondsUntilAcceptReady()
			local guiLeft = hub.subfuncs.ReadGuiCooldownSeconds()
			if guiLeft and guiLeft > left then
				left = guiLeft
			end
			if left <= 0 then
				break
			end
			hub.subfuncs.Log(string.format(
				"accept cooldown... %.1fs (opponentAccepted=%s)",
				left,
				tostring(opponentAccepted or hub.subfuncs.IsOpponentAcceptedGui())
			))
			task.wait(math.min(left, 1))
		end
		if not acceptScheduled then
			return
		end
		task.wait(hub.vars.AcceptDelay)
		if not acceptScheduled then
			return
		end

		local theirOffer = latestTheirOffer or {}
		local ourOffer = latestOurOffer or {}
		local theirTotal = hub.subfuncs.SumOffer(theirOffer)
		local ourTotal = hub.subfuncs.SumOffer(ourOffer)
		local theirCount = #theirOffer
		local ourCount = #ourOffer

		hub.subfuncs.Log(string.format(
			"pre-accept check | them=%.2f(%d) us=%.2f(%d) token=%s opponentAccepted=%s",
			theirTotal,
			theirCount,
			ourTotal,
			ourCount,
			tostring(lastOfferToken),
			tostring(opponentAccepted or hub.subfuncs.IsOpponentAcceptedGui())
		))

		if theirCount == 0 or ourCount == 0 then
			hub.subfuncs.Log("pre-accept ABORT - empty side")
			acceptScheduled = false
			return
		end
		if theirTotal < 1 or ourTotal < 1 then
			hub.subfuncs.Log("pre-accept ABORT - no allowed-tier value")
			acceptScheduled = false
			return
		end
		if theirTotal < ourTotal * hub.vars.MinProfit then
			hub.subfuncs.Log(string.format(
				"pre-accept ABORT - not in profit (need them >= %.2f, have %.2f)",
				ourTotal * hub.vars.MinProfit,
				theirTotal
			))
			acceptScheduled = false
			if not busy then
				busy = true
				pcall(hub.funcs.EvaluateAndFix, theirOffer, ourOffer)
				busy = false
			end
			return
		end
		if ourTotal > (theirTotal / hub.vars.MinProfit) + 0.01 then
			hub.subfuncs.Log("pre-accept ABORT - over budget")
			acceptScheduled = false
			if not busy then
				busy = true
				pcall(hub.funcs.EvaluateAndFix, theirOffer, ourOffer)
				busy = false
			end
			return
		end
		if hub.subfuncs.SecondsUntilAcceptReady() > 0 then
			hub.subfuncs.Log("pre-accept - cooldown restarted, reschedule")
			acceptScheduled = false
			hub.funcs.ScheduleAccept()
			return
		end
		if not lastOfferToken then
			hub.subfuncs.Log("pre-accept ABORT - no LastOffer token")
			acceptScheduled = false
			return
		end

		local ok, err = pcall(function()
			Trade.AcceptTrade:FireServer(game.PlaceId * 3, lastOfferToken)
		end)
		if ok then
			hub.subfuncs.Log(string.format(
				"AcceptTrade sent | us=%.2f them=%.2f (+%.1f%%)",
				ourTotal,
				theirTotal,
				(theirTotal - ourTotal) / ourTotal * 100
			))
		else
			warn(prefix.." AcceptTrade failed:", err)
		end
		acceptScheduled = false
	end)
end

hub.funcs.EvaluateAndFix = function(theirOffer, ourOffer)
	if not hub.vars.Enabled then return end
	if not hub.vars.AutoOffer then
		return
	end

	local theirFp = hub.subfuncs.Fingerprint(theirOffer)
	local theirTotal, theirKnown, theirUnknown, theirIgnored = hub.subfuncs.SumOffer(theirOffer)
	local ourTotal = hub.subfuncs.SumOffer(ourOffer)
	local theirCount = #(theirOffer or {})
	local ourCount = #(ourOffer or {})

	if theirCount == 0 then
		if ourCount > 0 then
			hub.subfuncs.Log("they cleared offer -> clearing ours")
			hub.subfuncs.ClearOurOffer(ourOffer)
		end
		lastHandledTheirFp = theirFp
		acceptScheduled = false
		return
	end

	if theirTotal < 1 then
		hub.subfuncs.Log(string.format(
			"their offer has no Godly/Unique/Ancient value (ignored %d low-tier) -> clear ours",
			theirIgnored or 0
		))
		acceptScheduled = false
		if ourCount > 0 then
			hub.subfuncs.ClearOurOffer(ourOffer)
		end
		lastHandledTheirFp = theirFp
		return
	end

	local theirChanged = theirFp ~= lastHandledTheirFp
	local profitable = hub.subfuncs.IsOfferProfitable(theirTotal, ourTotal)
	local over = hub.subfuncs.IsOfferOverBudget(theirTotal, ourTotal)
	local needOffer = ourCount == 0

	hub.subfuncs.Log(string.format(
		"check | them=%.2f(%d) us=%.2f(%d) profit=%s over=%s changed=%s cd=%.1fs",
		theirTotal, theirCount, ourTotal, ourCount,
		tostring(profitable), tostring(over), tostring(theirChanged),
		hub.subfuncs.SecondsUntilAcceptReady()
	))

	if theirChanged or needOffer or over or not profitable then
		hub.subfuncs.Log("rebuild offer (their change / missing / bad margin)")
		acceptScheduled = false

		if ourCount > 0 then
			hub.subfuncs.ClearOurOffer(ourOffer)
			task.wait(0.3)
		else
			alreadyOffered = {}
			pcall(function()
				Trade.CancelAccept:FireServer()
			end)
		end

		hub.funcs.RebuildOffer(theirTotal)
		lastHandledTheirFp = theirFp

		if hub.vars.AutoAccept then
			task.defer(function()
				task.wait(0.6)
				local t2 = hub.subfuncs.SumOffer(latestTheirOffer)
				local o2 = hub.subfuncs.SumOffer(latestOurOffer)
				if t2 >= 1 and o2 >= 1
					and t2 >= o2 * hub.vars.MinProfit
					and o2 <= (t2 / hub.vars.MinProfit) + 0.01
				then
					hub.funcs.ScheduleAccept()
				else
					hub.subfuncs.Log(string.format("post-rebuild skip accept | them=%.2f us=%.2f", t2, o2))
				end
			end)
		end
		return
	end

	hub.subfuncs.Log("offer OK - keep")
	lastHandledTheirFp = theirFp
	if hub.vars.AutoAccept then
		hub.funcs.ScheduleAccept()
	end
end

hub.funcs.OnOfferChanged = function(theirOffer, ourOffer)
	latestTheirOffer = theirOffer or {}
	latestOurOffer = ourOffer or {}
	acceptScheduled = false
	debounceToken += 1
	local myToken = debounceToken
	task.spawn(function()
		task.wait(0.45)
		if myToken ~= debounceToken then
			return
		end
		if busy then
			return
		end
		busy = true
		local ok, err = pcall(hub.funcs.EvaluateAndFix, latestTheirOffer, latestOurOffer)
		if not ok then
			warn(prefix.." evaluate error:", err)
		end
		busy = false
	end)
end

hub.funcs.OnUpdateTrade = function(data)
	if typeof(data) ~= "table" then
		return
	end
	if data.LastOffer ~= nil then
		lastOfferToken = data.LastOffer
	end

	local myKey, theirKey
	if data.Player1 and data.Player1.Player == LP then
		myKey, theirKey = "Player1", "Player2"
	elseif data.Player2 and data.Player2.Player == LP then
		myKey, theirKey = "Player2", "Player1"
	else
		return
	end

	local theirPlayer = data[theirKey] and data[theirKey].Player
	local theirName = theirPlayer and theirPlayer.Name or "?"
	local yourOffer = data[myKey] and data[myKey].Offer or {}
	local theirOffer = data[theirKey] and data[theirKey].Offer or {}
	latestOurOffer = yourOffer or {}
	latestTheirOffer = theirOffer or {}

	local yFp, yChanged = hub.subfuncs.PrintSide("YOUR OFFER", yourOffer, lastYour)
	local tFp, tChanged = hub.subfuncs.PrintSide("THEIR OFFER (" .. theirName .. ")", theirOffer, lastTheir)
	lastYour, lastTheir = yFp, tFp

	if yChanged or tChanged then
		lastOfferChangeAt = tick()
		opponentAccepted = false
		local yTotal = hub.subfuncs.SumOffer(yourOffer)
		local tTotal = hub.subfuncs.SumOffer(theirOffer)
		local diff = tTotal - yTotal
		local pct = yTotal > 0 and (diff / yTotal * 100) or 0
		print(string.format(
			"[Trade] vs %s | You: %s | Them: %s | Diff: %+d (%.1f%%) | cd=%.1fs",
			theirName,
			tostring(yTotal),
			tostring(tTotal),
			diff,
			pct,
			hub.subfuncs.SecondsUntilAcceptReady()
		))
		hub.funcs.OnOfferChanged(theirOffer, yourOffer)
	end
end

